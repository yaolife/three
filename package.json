{
  "name": "three-construction",
  "version": "1.0.0",
  "private": true,
  "main": "electron/main.js",
  "homepage": "./",
  "author": "ThreeConstruction Team",
  "description": "ThreeConstruction Desktop Application",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "electron:dev": "concurrently \"cross-env NODE_ENV=development vite\" \"wait-on http://localhost:5173 && cross-env NODE_ENV=development electron .\"",
    "electron:build": "vite build && electron-builder",
    "electron:build:win": "vite build && electron-builder --win",
    "electron:build:kylin": "vite build && electron-builder --linux"
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.1.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "element-plus": "^2.4.0",
    "konva": "^10.0.8",
    "lucide-react": "0.546.0",
    "next": "16.0.0",
    "path": "0.12.7",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "recordrtc": "^5.6.2",
    "tailwind-merge": "3.3.1",
    "tailwindcss-animate": "1.0.7",
    "three": "^0.181.0",
    "vue": "^3.3.8",
    "vue-konva": "^3.2.6",
    "vue-router": "^4.2.5"
  },
  "devDependencies": {
    "@types/node": "24.9.1",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@types/three": "^0.181.0",
    "@vitejs/plugin-vue": "^4.5.0",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "electron": "^28.0.0",
    "electron-builder": "^26.0.12",
    "postcss": "8.5.6",
    "tailwindcss": "4.1.15",
    "typescript": "5.9.3",
    "vite": "^4.5.0",
    "wait-on": "^9.0.3"
  },
  "build": {
    "appId": "com.threeconstruction.app",
    "productName": "ThreeConstruction",
    "afterExtract": "./build-hook.js",
    "beforePack": "./build-hook.js",
    "afterPack": "./build-hook.js",
    "afterAllArtifactBuild": "./build-hook.js",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "node_modules/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "dir"
        },
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon_256.png",
      "requestedExecutionLevel": "asInvoker"
    },
    "linux": {
      "target": [
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "Utility",
      "icon": "build/icon_1024.png",
      "vendor": "ThreeConstruction Team",
      "maintainer": "ThreeConstruction Team",
      "desktop": {
        "Name": "ThreeConstruction",
        "Comment": "ThreeConstruction Desktop Application",
        "Categories": "Utility;"
      }
    },
    "deb": {
      "depends": [
        "libnss3",
        "libatk-bridge2.0-0",
        "libdrm2",
        "libxkbcommon0",
        "libxcomposite1",
        "libxdamage1",
        "libxfixes3",
        "libxrandr2",
        "libgbm1",
        "libasound2"
      ],
      "priority": "optional"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
